{
  "info": {
    "_postman_id": "f1a2b3c4-financial-services-0001-000000000000",
    "name": "Financial Services",
    "description": "Personal Loan \"Personal Loan - Offline\" flow, converted to Beckn Protocol v2.0.0 LTS. Uses senderId/receiverId (not bapId/bppId), discover/on_discover naming, and networkId in namespace/registry-id format (nfh.global/testnet-fin-services).\n\nSet bap_adapter_url = http://localhost:8081/bap/caller before running. Run requests in sequence: discover -> select -> status -> confirm.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 \u2014 Discovery",
      "item": [
        {
          "name": "discover - PERSONAL_LOAN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"version\": \"2.0.0\",\n    \"action\": \"discover\",\n    \"senderId\": \"bap.example.com\",\n    \"bapUri\": \"https://bap.lending.example.com/beckn\",\n    \"networkId\": \"nfh.global/testnet\",\n    \"transactionId\": \"a9aaecca-10b7-4d19-b640-b047a7c62196\",\n    \"messageId\": \"bb579fb8-cb82-4824-be12-fcbc405b6608\",\n    \"timestamp\": \"2026-09-21T05:23:03.443Z\",\n    \"ttl\": \"PT10M\"\n  },\n  \"message\": {\n    \"intent\": {\n      \"category\": {\n        \"descriptor\": {\n          \"code\": \"PERSONAL_LOAN\"\n        }\n      },\n      \"tags\": [\n        {\n          \"descriptor\": {\n            \"code\": \"BAP_TERMS\",\n            \"name\": \"BAP Terms of Engagement\"\n          },\n          \"display\": false,\n          \"list\": [\n            {\n              \"descriptor\": {\n                \"code\": \"STATIC_TERMS\"\n              },\n              \"value\": \"https://bap.lending.example.com/personal-banking/loans/personal-loan\"\n            },\n            {\n              \"descriptor\": {\n                \"code\": \"OFFLINE_CONTRACT\"\n              },\n              \"value\": \"true\"\n            }\n          ]\n        }\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{bap_adapter_url}}/discover",
              "host": [
                "{{bap_adapter_url}}"
              ],
              "path": [
                "discover"
              ]
            },
            "description": "Borrower's CN discovers personal loan products from lender PNs (category PERSONAL_LOAN), passing CN terms-of-engagement (offline contract flag) as intent-level tags."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2 \u2014 Transaction",
      "item": [
        {
          "name": "select",
          "request": {
            "method": "POST",
            "header": [
