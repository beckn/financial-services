            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"version\": \"2.0.0\",\n    \"action\": \"select\",\n    \"senderId\": \"bap.example.com\",\n    \"bapUri\": \"https://bap.lending.example.com/beckn\",\n    \"receiverId\": \"bpp.example.com\",\n    \"bppUri\": \"https://bpp.northbridgebank.example.com/beckn\",\n    \"networkId\": \"nfh.global/testnet\",\n    \"transactionId\": \"a9aaecca-10b7-4d19-b640-b047a7c62196\",\n    \"messageId\": \"d1a2b3c4-1111-4a2b-9c3d-4e5f6a7b8c9d\",\n    \"timestamp\": \"2026-09-21T05:24:00.000Z\",\n    \"ttl\": \"PT10M\"\n  },\n  \"message\": {\n    \"selection\": {\n      \"providerId\": \"PROVIDER_ID\",\n      \"resourceIds\": [\n        \"ITEM_ID_PERSONAL_LOAN_1\"\n      ],\n      \"formSubmission\": {\n        \"id\": \"https://bpp.northbridgebank.example.com/xinput/formid/F01\",\n        \"submissionId\": \"F01_SUBMISSION_ID\",\n        \"data\": {\n          \"status\": \"SUCCESS\"\n        },\n        \"submittedAt\": \"2026-09-21T05:23:50.000Z\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{bap_adapter_url}}/select",
              "host": [
